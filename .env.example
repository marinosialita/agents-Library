# Server-side only. Copy to .env.local; never commit real keys.
OPENAI_API_KEY=
# Quality-first default (gpt-6-astra) or balanced (gpt-6.1-sol). Server-side, configurable.
AGENT_MODEL=gpt-6-astra
AGENT_MODEL_BALANCED=gpt-6.1-sol
AGENT_REASONING_EFFORT=medium
# Connections (docs/connections.md): Composio for Gmail, Google Calendar and Outlook, and the owner code that guards
# them until the app has accounts (16+ characters).
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIGS=
CONNECTIONS_OWNER_CODE=
# Routines (docs/routines.md): where they are kept on this machine, the dev server's minute clock, the sender of the
# e-mailed brief (else INBOUND_FROM_ADDRESS), and the secret the host's scheduler sends to /api/routines-tick.
ROUTINES_DIR=
ROUTINES_LOCAL_TICK=
ROUTINES_FROM_ADDRESS=
CRON_SECRET=
# Routines to Telegram (11 Nov 2026): your own bot from @BotFather, and the chat ids it may write to (yours). Each
# chat must have pressed Start on the bot first. Slack and Teams need no setting: they use the connected app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
